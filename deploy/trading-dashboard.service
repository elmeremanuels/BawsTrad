[Unit]
Description=BawsTrad Streamlit Dashboard
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/BawsTrad
Environment="PATH=/home/trader/.local/bin:/usr/bin:/bin"
# Belt-and-suspenders: ensures 'from src.X import Y' resolves when streamlit
# is launched outside uv run (e.g. direct invocation, IDE, future refactor).
# Primary fix: pyproject.toml [build-system] + uv sync installs src as package.
Environment="PYTHONPATH=/home/trader/BawsTrad"
ExecStart=/home/trader/.local/bin/uv run streamlit run src/dashboard/app.py \
    --server.address 0.0.0.0 \
    --server.port 8501 \
    --server.headless true \
    --browser.gatherUsageStats false
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-dashboard
MemoryMax=500M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
