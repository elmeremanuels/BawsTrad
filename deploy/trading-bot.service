[Unit]
Description=BawsTrad Trading Bot
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/BawsTrad
Environment="PATH=/home/trader/.local/bin:/usr/bin:/bin"
# Belt-and-suspenders: primary fix is uv sync installing src as a package
# (pyproject.toml [build-system]); PYTHONPATH covers plain python invocations.
Environment="PYTHONPATH=/home/trader/BawsTrad"
ExecStart=/home/trader/.local/bin/uv run python -m src.main --mode=paper
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-bot

# Resource limits — bot uses Alpaca WS + LLM calls, needs headroom
MemoryMax=1500M
CPUQuota=180%

[Install]
WantedBy=multi-user.target
